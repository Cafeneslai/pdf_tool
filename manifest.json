{
  "name": "PenguTools — Cute Online File Toolkit 🐧",
  "short_name": "PenguTools",
  "description": "เครื่องมือจัดการไฟล์ PDF รูปภาพ และยูทิลิตี้ออนไลน์น่ารัก สบายตา ปลอดภัย 100% ประมวลผลในเบราว์เซอร์ของคุณ",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fbff",
  "theme_color": "#0284c7",
  "orientation": "any",
  "categories": ["utilities", "productivity"],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["application/pdf", ".pdf", "image/*", "application/zip", ".zip"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "./assets/images/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/images/og-preview.png",
      "sizes": "1200x630",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
